<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.miage.fleet.controller.EntretienController"
           style="-fx-background-color: #f8fafc;">

    <ScrollPane fitToWidth="true" styleClass="scroll-pane" style="-fx-background-color: #f8fafc;">
        <VBox spacing="20" styleClass="main-content" style="-fx-background-color: #f8fafc;">

            <HBox alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS" spacing="4">
                    <Label text="Entretien &amp; Réparations" styleClass="page-title"/>
                    <Label text="Maintenance préventive et corrective du parc" styleClass="page-subtitle"/>
                </VBox>
                <Button text="+ Nouvel entretien" styleClass="btn-primary" onAction="#showNewEntretienForm"/>
            </HBox>

            <HBox spacing="16" fx:id="statsRow"/>

            <!-- Filters -->
            <VBox styleClass="filter-card" spacing="10">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <HBox styleClass="input-with-icon" spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                        <Label text="🔍" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                        <TextField fx:id="searchField" styleClass="input-search"
                                   promptText="Rechercher par véhicule, type..."
                                   HBox.hgrow="ALWAYS" onKeyReleased="#applyFilters"/>
                    </HBox>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Statut :" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                    <HBox fx:id="statutFilters" spacing="6"/>
                    <Label text="|" style="-fx-text-fill: #cbd5e1;"/>
                    <Label text="Nature :" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                    <HBox fx:id="natureFilters" spacing="6"/>
                </HBox>
            </VBox>

            <!-- Cards container -->
            <VBox fx:id="cardsContainer" spacing="12"/>

            <!-- Empty state -->
            <VBox fx:id="emptyState" alignment="CENTER" spacing="12"
                  style="-fx-padding: 64 0;" visible="false" managed="false">
                <Label text="🔧" style="-fx-font-size: 48px; -fx-opacity: 0.2;"/>
                <Label text="Aucun entretien trouvé" style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;"/>
            </VBox>

        </VBox>
    </ScrollPane>

    <StackPane fx:id="modalOverlay" visible="false" managed="false"
               style="-fx-background-color: rgba(0,0,0,0.5);"
               onMouseClicked="#closeModal"/>

</StackPane>
