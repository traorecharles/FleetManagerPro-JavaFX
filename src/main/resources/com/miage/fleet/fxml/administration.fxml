<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.miage.fleet.controller.AdministrationController">

    <ScrollPane fitToWidth="true" styleClass="scroll-pane" style="-fx-background-color: #f8fafc;">
        <VBox spacing="20" styleClass="main-content" style="-fx-background-color: #f8fafc;">

            <VBox spacing="4">
                <Label text="Administration" styleClass="page-title"/>
                <Label text="Gestion des utilisateurs et configuration du système" styleClass="page-subtitle"/>
            </VBox>

            <!-- Users card -->
            <VBox styleClass="card" spacing="0" style="-fx-padding: 0;">
                <HBox style="-fx-padding: 16 20; -fx-border-color: transparent transparent #f1f5f9 transparent; -fx-border-width: 1;"
                      alignment="CENTER_LEFT">
                    <Label text="👥  Utilisateurs du système" styleClass="card-title" HBox.hgrow="ALWAYS"/>
                    <Button text="+ Ajouter un utilisateur" styleClass="btn-primary"
                            style="-fx-padding: 8 12; -fx-font-size: 12px;"
                            onAction="#showNewUserForm"/>
                </HBox>
                <VBox fx:id="usersTable"/>
            </VBox>

            <!-- System settings card -->
            <VBox styleClass="card" spacing="16">
                <Label text="⚙ Configuration du système" styleClass="card-title"/>
                <HBox spacing="16">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Seuil alerte assurance (jours)" styleClass="form-label"/>
                        <TextField fx:id="seuilAssurance" text="30" styleClass="form-input"/>
                    </VBox>
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Seuil alerte visite technique (jours)" styleClass="form-label"/>
                        <TextField fx:id="seuilVisite" text="60" styleClass="form-input"/>
                    </VBox>
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Intervalle entretien (km)" styleClass="form-label"/>
                        <TextField fx:id="intervalleEntretien" text="5000" styleClass="form-input"/>
                    </VBox>
                </HBox>
                <Button text="Enregistrer la configuration" styleClass="btn-primary"
                        style="-fx-padding: 10 20;"
                        onAction="#saveConfig"/>
            </VBox>

        </VBox>
    </ScrollPane>

    <!-- Modal overlay -->
    <StackPane fx:id="modalOverlay"
               style="-fx-background-color: rgba(0,0,0,0.5);"
               visible="false" managed="false"
               onMouseClicked="#closeModal"/>

</StackPane>
