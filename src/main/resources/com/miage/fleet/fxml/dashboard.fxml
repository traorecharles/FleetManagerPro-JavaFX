<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.miage.fleet.controller.DashboardController"
            fitToWidth="true"
            styleClass="scroll-pane"
            style="-fx-background-color: #f8fafc;">

    <VBox spacing="24" styleClass="main-content" style="-fx-background-color: #f8fafc;">

        <!-- Page header -->
        <VBox spacing="4">
            <Label text="Tableau de bord" styleClass="page-title"/>
            <Label fx:id="dateLabel" styleClass="page-subtitle"/>
        </VBox>

        <!-- KPI Cards (4 columns) -->
        <HBox spacing="16" fx:id="kpiRow">
            <!-- Injected by controller -->
        </HBox>

        <!-- Charts row -->
        <HBox spacing="16" fx:id="chartsRow">
            <!-- Area chart (2/3 width) -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="4">
                <Label text="Missions par mois" styleClass="card-title"/>
                <Label text="Nombre d'ordres de mission — 2025" styleClass="card-subtitle"/>
                <StackPane fx:id="areaChartContainer" minHeight="220" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Pie chart (1/3 width) -->
            <VBox styleClass="card" minWidth="280" maxWidth="320" spacing="4">
                <Label text="Statuts du parc" styleClass="card-title"/>
                <Label text="Répartition actuelle" styleClass="card-subtitle"/>
                <StackPane fx:id="pieChartContainer" minHeight="180"/>
                <VBox fx:id="pieLegend" spacing="6" style="-fx-padding: 8 0 0 0;"/>
            </VBox>
        </HBox>

        <!-- Bottom row -->
        <HBox spacing="16" fx:id="bottomRow">

            <!-- Current missions (2/3) -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="0" style="-fx-padding: 0;">
                <HBox style="-fx-padding: 16 20; -fx-border-color: transparent transparent #f1f5f9 transparent; -fx-border-width: 1;"
                      alignment="CENTER_LEFT">
                    <Label text="Missions en cours" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Voir toutes →" styleClass="link-btn" onAction="#handleVoirToutes"/>
                </HBox>
                <VBox fx:id="missionsListContainer"/>
            </VBox>

            <!-- Alerts (1/3) -->
            <VBox styleClass="card" minWidth="280" maxWidth="340" spacing="0" style="-fx-padding: 0;">
                <HBox style="-fx-padding: 16 20; -fx-border-color: transparent transparent #f1f5f9 transparent; -fx-border-width: 1;"
                      alignment="CENTER_LEFT">
                    <Label text="Alertes &amp; Échéances" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="alertCountBadge" style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-padding: 2 8; -fx-background-radius: 20; -fx-font-size: 11px; -fx-font-weight: bold;" visible="false" managed="false"/>
                </HBox>
                <VBox fx:id="alertsContainer" spacing="8" style="-fx-padding: 16;"/>
                <!-- KM mini chart -->
                <VBox style="-fx-padding: 0 16 16 16;" spacing="4">
                    <Label text="Kilométrage mensuel (km)" styleClass="card-subtitle"/>
                    <StackPane fx:id="barChartContainer" minHeight="80"/>
                </VBox>
            </VBox>

        </HBox>

    </VBox>
</ScrollPane>
