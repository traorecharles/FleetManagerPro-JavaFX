<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.miage.fleet.controller.MissionsController"
           style="-fx-background-color: #f8fafc;">

    <!-- Main content -->
    <ScrollPane fitToWidth="true" styleClass="scroll-pane" style="-fx-background-color: #f8fafc;">
        <VBox spacing="20" styleClass="main-content" style="-fx-background-color: #f8fafc;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS" spacing="4">
                    <Label text="Missions" styleClass="page-title"/>
                    <Label text="Ordres de mission — déplacements professionnels" styleClass="page-subtitle"/>
                </VBox>
                <Button text="+ Nouvel ordre de mission" styleClass="btn-primary" onAction="#showNewMissionForm"/>
            </HBox>

            <!-- Stats cards -->
            <HBox fx:id="statsRow" spacing="16"/>

            <!-- Filters -->
            <HBox styleClass="filter-card" spacing="12" alignment="CENTER_LEFT">
                <HBox styleClass="input-with-icon" spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Label text="🔍" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                    <TextField fx:id="searchField"
                               styleClass="input-search"
                               promptText="Rechercher par employé, destination, véhicule..."
                               HBox.hgrow="ALWAYS"
                               onKeyReleased="#applyFilters"/>
                </HBox>
                <HBox fx:id="statusFilters" spacing="6"/>
            </HBox>

            <!-- Mission cards list -->
            <VBox fx:id="missionsContainer" spacing="12"/>

            <!-- Empty state -->
            <VBox fx:id="emptyState" alignment="CENTER" spacing="12"
                  style="-fx-padding: 64 0;" visible="false" managed="false">
                <Label text="✈" style="-fx-font-size: 48px; -fx-opacity: 0.2;"/>
                <Label text="Aucune mission trouvée" style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;"/>
            </VBox>

        </VBox>
    </ScrollPane>

    <!-- Modal overlay (on top of scroll content) -->
    <StackPane fx:id="modalOverlay" visible="false" managed="false"
               style="-fx-background-color: rgba(0,0,0,0.5);"
               onMouseClicked="#closeModal"/>

</StackPane>
